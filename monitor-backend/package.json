{
  "name": "reglocation-monitor-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RegLocation — backend (API, Socket.IO, OCR) и монитор ресепшена",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,monitor -c blue,green \"npm:dev:server\" \"npm:dev:monitor\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:monitor": "vite --config monitor/vite.config.ts",
    "build": "npm run build:monitor && npm run build:server",
    "build:monitor": "vite build --config monitor/vite.config.ts",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/server/index.js",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/vercel.js",
    "start": "node --enable-source-maps dist/server/index.js",
    "start:prod": "prisma migrate deploy && node --enable-source-maps dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p monitor/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "check:migrations": "node scripts/check-migrations.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@napi-rs/canvas": "^1.0.11",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "^6.4.299",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "tesseract.js": false
  }
}

# ─── RegLocation Monitor + Backend: переменные окружения ───
# Скопируйте в .env для локального запуска. В облаке задайте их в панели хостинга (не коммитьте секреты в GitHub!).

NODE_ENV=production
PORT=8080

# PostgreSQL (Railway/Render подставляют автоматически)
DATABASE_URL=postgresql://user:password@host:5432/reglocation?schema=public

# Публичные адреса двух сайтов (без / в конце)
PUBLIC_MONITOR_URL=https://monitor.example.com
PUBLIC_APP_URL=https://app.example.com
# Дополнительные разрешённые домены через запятую (например, временные адреса хостинга)
CORS_ORIGINS=

# Email владельца: только он сможет создать первый аккаунт директора (подтверждение кодом из письма)
INITIAL_DIRECTOR_EMAIL=director@school.uz

# Почта для кодов подтверждения (Gmail с паролем приложения, Brevo, Mailgun, Resend SMTP …)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=school.reglocation@gmail.com
SMTP_PASS=пароль-приложения
MAIL_FROM=RegLocation <school.reglocation@gmail.com>

# Хранилище фото и расписаний: database (в PostgreSQL, по умолчанию) или s3 (Cloudflare R2, Backblaze B2, AWS S3)
STORAGE_DRIVER=database
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# За прокси хостинга (Railway/Render) — 1
TRUST_PROXY=1
# Языки распознавания расписаний (узбекская латиница читается как eng)
OCR_LANGS=eng+rus
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=6
LOG_LEVEL=info

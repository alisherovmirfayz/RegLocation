# ─── RegLocation Teacher + Director ───
# Адрес backend (проект №1). Сайт проксирует к нему /api и /socket.io,
# поэтому для браузера всё работает на одном домене (cookie и WebSocket без проблем CORS).
# Railway: внутренний адрес вида http://reglocation-monitor.railway.internal:8080
# Render:  внутренний адрес вида http://reglocation-monitor:10000 (подставляется автоматически из render.yaml)
API_UPSTREAM=https://monitor.example.com
PORT=8080
NODE_ENV=production
